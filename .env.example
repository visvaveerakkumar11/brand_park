# Copy to .env for local development. Never commit real secrets.

# PostgreSQL connection string.
# Local: `npm run db:start` serves postgres://postgres:postgres@localhost:5433/brandpark
# Vercel: use a pooled connection string from your provider (Neon, Supabase, Prisma Postgres, ...).
DATABASE_URL="postgres://postgres:postgres@localhost:5433/brandpark"

# Max DB connections per server instance (default 10). Keep small (1–5) on serverless.
DATABASE_POOL_MAX="10"

# Public base URL, used for canonical links, sitemap, JSON-LD and password-reset links.
APP_URL="http://localhost:3000"

# Razorpay online payments. Leave both blank to disable online payment.
# Use test-mode keys (rzp_test_...) until you are ready to take real payments.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Cash on delivery. A business decision: set to "true" only if you will fulfil COD orders.
ENABLE_COD="false"
